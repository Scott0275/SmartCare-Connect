# S3 Configuration (Staging)
S3_BUCKET=smartcare-staging-medical-files
CLOUDFRONT_DOMAIN=d3a536up40gvsk.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID intentionally left blank (use secure secret store)

# Lambda Configuration
LAMBDA_TIMEOUT=60
LAMBDA_MEMORY=512

# Environment
NODE_ENV=staging
DEBUG=false
ENABLE_MONITORING=true

# Monitoring & Logging
CLOUDWATCH_LOG_GROUP=/aws/lambda/smartcare-staging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# HIPAA Compliance
ENABLE_ENCRYPTION=true
ENABLE_AUDIT_LOGGING=true
ENABLE_MFA=true
## WARNING: Do NOT commit real secrets into files. Use Amplify environment variables or a secrets manager.
STAGING_API=https://5jlr7hmqv5.execute-api.us-east-2.amazonaws.com/staging
COGNITO_CLIENT_ID=2e5sdfoptopi4kpu6qun90hcos

# Next.js public envs (Amplify needs these set in app -> environment variables to be available at build time)
NEXT_PUBLIC_USE_AWS=true
