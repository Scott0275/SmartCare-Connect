+
+  attribute {
+    name = "patientId"
+    type = "S"
+  }
+
+  global_secondary_index {
+    name            = "PatientIndex"
+    hash_key        = "patientId"
+    projection_type = "ALL"
+  }
+
+  server_side_encryption {
+    enabled = true
+  }
+
+  point_in_time_recovery {
+    enabled = true
+  }
+
