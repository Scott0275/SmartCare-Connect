+}
+
+output "s3_bucket" {
+  description = "S3 bucket name for staging"
+  value       = module.storage.s3_bucket_name
+}
+
+output "cloudfront_domain" {
+  description = "CloudFront domain for staging"
+  value       = module.storage.cloudfront_domain_name
+}
