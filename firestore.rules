rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules more readable
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Admins can read and write to any user document
      allow read, write: if hasRole('admin');
      // Users can read their own document
      allow read: if isOwner(userId);
    }

    // Rules for the 'patients' collection
    match /patients/{patientId} {
      // Doctors and nurses can read any patient data
      allow read: if hasRole('doctor') || hasRole('nurse');
      // Patients can only read their own data
      allow read: if isOwner(patientId);
      // Nurses can create new patients
      allow create: if hasRole('nurse');
      // Doctors and nurses can update patient data
      allow update: if hasRole('doctor') || hasRole('nurse');
    }

    // Rules for 'prescriptions'
    match /prescriptions/{prescriptionId} {
        // Doctors can create prescriptions
        allow create: if hasRole('doctor');
        // Doctors and nurses can read any prescription
        allow read: if hasRole('doctor') || hasRole('nurse');
        // Patients can read their own prescriptions (assuming a field 'patientId' in the document)
        allow read: if isOwner(resource.data.patientId);
    }

    // Rules for 'vitals'
    match /vitals/{vitalId} {
        // Nurses can create new vitals
        allow create: if hasRole('nurse');
        // Doctors and nurses can read any vitals
        allow read: if hasRole('doctor') || hasRole('nurse');
        // Patients can read their own vitals (assuming a field 'patientId' in the document)
        allow read: if isOwner(resource.data.patientId);
    }
  }
}
