rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read their own user doc
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // keep user write restricted (set from server)
    }

    // Patients collection
    match /patients/{patientId} {
      allow read: if request.auth != null && (
        // nurses, doctors, admins can read
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['nurse','doctor','admin']
      );

      // Only nurses (and admin) may create patients
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['nurse','admin'];

      // Allow updates/deletes only by admin
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Visits collection
    match /visits/{visitId} {
      // nurses, doctors, admins can read
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['nurse','doctor','admin'];

      // nurses and doctors can create visits
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['nurse','doctor','admin'];

      // updates/deletes maybe restricted to admin only
      allow update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Optional: restrict other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}